{
    "settings_popup": {
        "type": "dock",
        "content": [
        {
            "type": "tabbed",
            "tabs": [
                {
                    "title": "General",
                    "content": {
                        "type": "array",
                        "orientation": "vertical",
                        "h_alignment": "left",
                        "content": [
                            {
                                "type": "group",
                                "header": "Sanities",
                                "dock": "top",
                                "content": {
                                    "type": "layout",
                                    "key": "sanity_grid"
                                }
                            },
                            {
                                "type": "group",
                                "header": "Logic",
                                "dock": "top",
                                "content": {
                                    "type": "layout",
                                    "key": "logic_grid"
                                }
                            },
                            {
                                "type": "group",
                                "header": "Roadblocks",
                                "dock": "top",
                                "content": {
                                    "type": "layout",
                                    "key": "roadblock_grid"
                                }
                            }
                        ]
                    }
                }, // You can easily add a second tab in here!
                //{
                //    "title": "Dex Logic",
                //    "content": {
                //        "type": "array",
                //        "orientation": "vertical",
                //        "h_alignment": "left",
                //        "content": [
