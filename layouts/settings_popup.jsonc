                //                "header": "Evolution Logic",
                //                "dock": "top",
                //                "content": {
                //                    "type": "layout",
                //                    "key": "evo_logic_grid"
                //                }
                //            },
                //            {
                //                "type": "group",
                //                "header": "Information",
                //                "dock": "top",
                //                "content": {
                //                    "type": "layout",
                //                    "key": "information_grid"
                //                }
                //            }
                //        ]
                //    }
                //}
            ]
        }
        ],
    },
    "sanity_grid": {
        "type": "itemgrid",
        "item_margin": "2, 2",
        "item_size": "64,64", // normally you don't set these so absurdly large but I cannot even grab the popout window because it's so small!
                              // Update: turns out it was too big and the settings popout window was too big for some users' monitors. So remember: your monitor isn't everyone's monitor.
        "item_h_alignment": "center",
        "item_v_alignment": "center",
        "h_alignment": "center",
        "rows": [
            [
                "extrastartingchest"
            ]
        ]
    },
    "logic_grid": {
        "type": "itemgrid",
        "item_margin": "2, 2",
        "item_size": "64,64",
        "item_h_alignment": "center",
        "item_v_alignment": "center",
        "h_alignment": "center",
        "rows": [
            [
                "hardmode"
            ]
        ]
    },
    "roadblock_grid": {
        "type": "itemgrid",
        "item_margin": "2, 2",
        "item_size": "64,64",
        "item_h_alignment": "center",
        "item_v_alignment": "center",
        "h_alignment": "left",
        "rows": [
            [
                "hammer_setting"
            ]
        ]
    }
}